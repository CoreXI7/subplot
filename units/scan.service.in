[Unit]
Description=Subplot: build library.json from the Plex DB copy (no network, no secrets, no media)
OnSuccess=@UNIT_PREFIX@-find.service

[Service]
Type=oneshot
User=@RUN_USER@
Group=@RUN_GROUP@
ExecStart=/usr/bin/python3 -I @CODE_DIR@/subplot/scan.py
Environment=SUBS_STATE=@STATE_DIR@
Environment=SUBS_RULES=@CONFIG_DIR@/rules.json
Environment=SUBS_ENV=@CONFIG_DIR@/.env
Environment="SUBS_PLEX_DB=@PLEX_DB@"
Environment=SUBS_PC=@PC_HOST@
Environment=SUBS_PC_ROOT=@PC_ROOT@
Environment=SUBS_HOST=@PUBLIC_HOST@
Environment=SUBS_SOCK=@SOCKET@
Environment=SUBS_SOCK_GROUP=@PROXY_GROUP@
Environment=SUBS_MARKER_TAG=@MARKER_TAG@
Environment="SUBS_USER_AGENT=@USER_AGENT@"
Environment=SUBS_NAV_FILE=@CONFIG_DIR@/nav.json
Environment=SUBS_OVERLAY=@OVERLAY_DIR@
TimeoutStartSec=30min
BindPaths=@STATE_DIR@
BindReadOnlyPaths="@PLEX_DB_DIR@"
InaccessiblePaths=-@STATE_DIR@/auth
InaccessiblePaths=-@CONFIG_DIR@/.env
InaccessiblePaths=-@STATE_DIR@/tokens
InaccessiblePaths=-@MEDIA_ROOT@
InaccessiblePaths=-@HIDE_PATH@
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=2G
TasksMax=16
CPUQuota=50%
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@CODE_DIR@
BindReadOnlyPaths=@CONFIG_DIR@
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug

[Install]
WantedBy=multi-user.target
